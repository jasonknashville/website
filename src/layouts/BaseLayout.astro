---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

type Props = {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
};

const { title, description, image = 'https://kvcore-library.s3.amazonaws.com/remax1stchoice8207/images/36e9d94a41744196b10ed128cf51dce2.jpeg', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title.includes('Jason Kaczmarski') ? title : `${title} | Jason Kaczmarski Team`;
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: 'The Jason Kaczmarski Team',
  url: 'https://jasonknashville.com',
  telephone: '+1-615-384-7355',
  image,
  parentOrganization: { '@type': 'Organization', name: 'RE/MAX 1st Choice' },
  areaServed: ['Nashville', 'Middle Tennessee', 'Wilson County', 'Williamson County'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-MH9X9NGV');
    </script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var match = window.location.pathname.match(/^\/tools\/([^/]+)\/?/);
        if (!match) return;

        var toolId = match[1];
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'tool_view', tool_id: toolId });

        var started = false;
        var calculated = false;
        document.addEventListener('input', function (event) {
          if (started || !event.target.closest('main')) return;
          if (!event.target.matches('input, select, textarea')) return;
          started = true;
          window.dataLayer.push({ event: 'tool_start', tool_id: toolId });
        }, { passive: true });

        document.addEventListener('change', function (event) {
          if (calculated || !event.target.closest('main')) return;
          if (!event.target.matches('input, select, textarea')) return;
          if (event.target.closest('[data-analytics-calculation="manual"]')) return;
          calculated = true;
          window.dataLayer.push({ event: 'tool_calculate', tool_id: toolId });
        }, { passive: true });

        document.addEventListener('click', function (event) {
          var tracked = event.target.closest('[data-analytics-event]');
          if (tracked) {
            window.dataLayer.push({
              event: tracked.getAttribute('data-analytics-event'),
              tool_id: toolId,
              tool_action: tracked.getAttribute('data-analytics-action') || undefined
            });
          }

          var link = event.target.closest('a');
          if (!link) return;
          var href = link.getAttribute('href') || '';
          if (href.startsWith('mailto:') || href.startsWith('tel:') || href.includes('/contact.php')) {
            window.dataLayer.push({
              event: 'tool_contact_click',
              tool_id: toolId,
              contact_destination: link.textContent.trim().slice(0, 60)
            });
          }
        });
      });
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MH9X9NGV" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
