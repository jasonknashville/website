---
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/tools/', label: 'Tools' },
  { href: '/guides/', label: 'Guides' },
  { href: '/areas/', label: 'Areas' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Jason Kaczmarski home">
      <img src="https://kvcore-library.s3.amazonaws.com/remax1stchoice8207/images/03b9616f75a8e185d56a93c799829fdf.png" width="48" height="48" alt="" />
      <span><strong>RE/MAX 1st Choice</strong><small>Jason Kaczmarski · The Jason Kaczmarski Team</small></span>
    </a>
    <nav aria-label="Primary navigation">
      {nav.map((item) => <a class:list={{ active: currentPath.startsWith(item.href) }} href={item.href}>{item.label}</a>)}
    </nav>
    <a class="contact" href="https://jasonk.remax.com/contact.php">Talk with Jason</a>
    <details class="mobile-menu">
      <summary aria-label="Open navigation">Menu</summary>
      <div>
        {nav.map((item) => <a class:list={{ active: currentPath.startsWith(item.href) }} href={item.href}>{item.label}</a>)}
        <a href="https://the-jason-kaczmarski-team-springfield-tn.remax.com/">Search homes</a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,.97); border-bottom: 1px solid var(--line); backdrop-filter: blur(10px); }
  .header-inner { min-height: 76px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1.5rem; }
  .brand { display: inline-flex; align-items: center; gap: .75rem; text-decoration: none; min-width: 0; }
  .brand img { width: 48px; height: 48px; object-fit: contain; }
  .brand strong, .brand small { display: block; white-space: nowrap; }
  .brand strong { color: var(--ink); font-size: 1rem; font-weight: 600; letter-spacing: .01em; }
  .brand small { color: var(--muted); font-size: .66rem; letter-spacing: .02em; }
  nav { display: flex; gap: 1.45rem; }
  nav a { padding: .25rem 0; border-bottom: 1px solid transparent; color: var(--muted); font-size: .82rem; font-weight: 500; text-decoration: none; }
  nav a:hover, nav a.active { border-color: var(--ink); color: var(--ink); }
  .contact { justify-self: end; padding: .55rem .8rem; border: 1px solid var(--ink); border-radius: var(--radius-sm); color: var(--ink); font-size: .78rem; font-weight: 600; text-decoration: none; }
  .mobile-menu { display: none; position: relative; justify-self: end; }
  .mobile-menu summary { cursor: pointer; color: var(--navy-900); font-size: .82rem; font-weight: 700; list-style: none; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu div { position: absolute; right: 0; top: 2rem; min-width: 210px; padding: .6rem; border: 1px solid var(--line); border-radius: var(--radius-md); background: white; box-shadow: var(--shadow); }
  .mobile-menu a { display: block; padding: .7rem .8rem; border-radius: .5rem; color: var(--muted); font-size: .9rem; font-weight: 700; text-decoration: none; }
  .mobile-menu a:hover, .mobile-menu a.active { color: var(--navy-900); background: var(--mist); }
  @media (max-width: 880px) {
    .header-inner { grid-template-columns: 1fr auto auto; }
    nav { display: none; }
    .mobile-menu { display: block; }
  }
  @media (max-width: 520px) {
    .brand small { display: none; }
    .contact { display: none; }
    .header-inner { grid-template-columns: 1fr auto; }
  }
</style>
