---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Worksheet submitted" description="Your buyer offer worksheet has been submitted." noindex={true}>
  <section class="confirmation">
    <p class="eyebrow">Buyer Offer Worksheet</p>
    <h1>Thank you — your worksheet has been submitted.</h1>
    <p>Jason will review your answers and follow up with you about the next steps.</p>
    <p><strong>This worksheet does not create an offer or contract.</strong> The purchase documents still need to be prepared, reviewed and signed.</p>
    <p>Need to correct something? Email <a href="mailto:jason@jasonknashville.com">jason@jasonknashville.com</a>.</p>
    <a href="/">Return to the home page</a>
  </section>
</BaseLayout>
<style>
  .confirmation { max-width: 760px; margin: 48px auto; padding: 32px 24px; }
  .eyebrow { color: #003da5; font-weight: 700; }
  h1 { color: #172a46; line-height: 1.2; }
  p { margin: 20px 0; line-height: 1.7; }
  a { color: #003da5; }
</style>
