---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ideal Home Quiz | 60-Second Clarity Check"
  description="Identify what is missing from your current home, name every obstacle to moving, and get practical next-step tools tailored to your answers."
>
  <section class="quiz-hero">
    <div class="container">
      <span class="eyebrow">A 60-second clarity check</span>
      <h1>How far are you from your ideal home?</h1>
      <p>Not the perfect house. The home you would choose if you were starting from scratch today.</p>
      <div class="privacy-note">Your answers stay in this browser. The optional money section uses rough ranges only.</div>
    </div>
  </section>

  <section class="section quiz-section">
    <div class="container quiz-container">
      <div id="idealHomeQuiz" class="quiz-app" aria-live="polite"></div>
      <noscript>
        <div class="quiz-card">
          <h2>JavaScript is needed for this quiz.</h2>
          <p>You can still browse all of the planning calculators from the tools page.</p>
          <a class="quiz-button primary" href="/tools/">See all planning tools</a>
        </div>
      </noscript>
    </div>
  </section>
</BaseLayout>

<style>
  .quiz-hero {
    padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(3rem, 6vw, 5rem);
    background:
      radial-gradient(circle at 86% 18%, rgba(214, 31, 53, .18), transparent 28rem),
      linear-gradient(145deg, var(--navy-950), var(--navy-800));
    color: white;
  }
  .quiz-hero .eyebrow { color: #f2cfd4; }
  .quiz-hero h1 {
    max-width: 850px;
    margin-bottom: 1rem;
    font-size: clamp(2.65rem, 6vw, 5.25rem);
  }
  .quiz-hero > .container > p {
    max-width: 690px;
    margin-bottom: 1.3rem;
    color: rgba(255, 255, 255, .76);
    font-size: clamp(1.02rem, 2vw, 1.2rem);
  }
  .privacy-note {
    display: inline-flex;
    padding: .65rem .85rem;
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: .75rem;
    background: rgba(255, 255, 255, .07);
    color: rgba(255, 255, 255, .72);
    font-size: .8rem;
  }
  .quiz-section { background: var(--mist); }
  .quiz-container { max-width: 900px; }
  .quiz-app { min-height: 480px; }
  .quiz-card {
    padding: clamp(1.35rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow);
  }
  .quiz-intro {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg);
    background: var(--navy-900);
    color: white;
    box-shadow: var(--shadow);
  }
  .quiz-intro h2 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.65rem);
  }
  .quiz-intro p {
    max-width: 680px;
    margin: 0;
    color: rgba(255, 255, 255, .72);
    font-size: 1.02rem;
  }
  .quiz-intro-meta {
    color: rgba(255, 255, 255, .58);
    font-size: .8rem;
    font-weight: 600;
  }
  .quiz-progress { margin-bottom: 1rem; }
  .quiz-progress-track {
    height: .45rem;
    overflow: hidden;
    border-radius: 999px;
    background: #dfe6ee;
  }
  .quiz-progress-fill {
    height: 100%;
    border-radius: inherit;
    background: var(--red-600);
    transition: width .25s ease;
  }
  .quiz-progress-label {
    margin-top: .45rem;
    color: var(--muted);
    font-size: .74rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-align: right;
    text-transform: uppercase;
  }
  .question-label {
    display: block;
    margin-bottom: .65rem;
    color: var(--red-600);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .quiz-card h2 { margin-bottom: .6rem; }
  .question-help {
    max-width: 680px;
    margin-bottom: 1.35rem;
    color: var(--muted);
  }
  .option-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .7rem;
  }
  .option-grid.two-wide { grid-template-columns: 1fr 1fr; }
  .quiz-option {
    display: flex;
    gap: .75rem;
    align-items: center;
    min-height: 3.4rem;
    padding: .8rem .9rem;
    border: 1px solid var(--line);
    border-radius: .85rem;
    background: white;
    color: var(--ink);
    font-weight: 650;
    text-align: left;
    cursor: pointer;
    transition: border-color .18s ease, background .18s ease, transform .18s ease;
  }
  .quiz-option:hover {
    transform: translateY(-1px);
    border-color: #aebdcd;
    background: #f9fbfd;
  }
  .quiz-option.selected {
    border-color: var(--blue-600);
    background: #edf5fd;
    color: var(--navy-900);
  }
  .option-check {
    display: grid;
    flex: 0 0 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    border: 1px solid #b7c4d1;
    border-radius: .35rem;
    background: white;
  }
  .quiz-option.selected .option-check {
    border-color: var(--blue-600);
    background: var(--blue-600);
  }
  .option-check::after {
    content: '';
    width: .55rem;
    height: .3rem;
    transform: rotate(-45deg) translateY(-1px);
    border-bottom: 2px solid transparent;
    border-left: 2px solid transparent;
  }
  .quiz-option.selected .option-check::after {
    border-color: white;
  }
  .selection-note {
    margin: .75rem 0 0;
    color: var(--muted);
    font-size: .78rem;
  }
  .selection-note.warning { color: var(--red-600); font-weight: 700; }
  .quiz-textarea {
    width: 100%;
    min-height: 125px;
    resize: vertical;
    padding: .9rem 1rem;
    border: 1px solid var(--line);
    border-radius: .85rem;
    color: var(--ink);
    background: white;
  }
  .quiz-textarea:focus,
  .range-row input:focus-visible,
  .quiz-option:focus-visible,
  .quiz-button:focus-visible {
    outline: 3px solid rgba(22, 95, 172, .25);
    outline-offset: 2px;
  }
  .quiz-nav {
    display: flex;
    justify-content: space-between;
    gap: .75rem;
    margin-top: 1.5rem;
  }
  .quiz-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: .75rem 1.05rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: white;
    color: var(--navy-900);
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }
  .quiz-button.primary {
    border-color: var(--red-600);
    background: var(--red-600);
    color: white;
  }
  .quiz-button.primary:hover { background: var(--red-700); }
  .quiz-button.secondary:hover { background: var(--mist); }
  .quiz-button:disabled { opacity: .45; cursor: not-allowed; }
  .intro-button { justify-self: start; margin-top: .35rem; }
  .skip-button {
    display: block;
    margin: .85rem auto 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: .8rem;
    text-decoration: underline;
    cursor: pointer;
  }
  .range-list { display: grid; gap: 1.25rem; }
  .range-row {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: .85rem;
    background: var(--mist);
  }
  .range-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .6rem;
    font-size: .86rem;
  }
  .range-heading strong { color: var(--navy-900); }
  .range-row input { width: 100%; accent-color: var(--red-600); }
  .result-stack { display: grid; gap: 1rem; }
  .result-hero {
    padding: clamp(1.4rem, 4vw, 2.4rem);
    border-radius: var(--radius-lg);
    background: var(--navy-900);
    color: white;
  }
  .result-hero .eyebrow { margin-bottom: .65rem; color: #f2cfd4; }
  .result-hero h2 { margin-bottom: .65rem; }
  .result-hero p { max-width: 720px; margin: 0; color: rgba(255, 255, 255, .72); }
  .result-panel {
    padding: clamp(1.2rem, 3vw, 1.8rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: white;
  }
  .result-panel h3 { margin-bottom: .6rem; }
  .result-panel > p { color: var(--muted); }
  .priority-tags { display: flex; flex-wrap: wrap; gap: .55rem; }
  .priority-tag {
    padding: .45rem .65rem;
    border-radius: 999px;
    background: var(--sand);
    color: var(--navy-900);
    font-size: .78rem;
    font-weight: 700;
  }
  .one-thing {
    margin: .75rem 0 0;
    padding: 1rem;
    border-left: 4px solid var(--red-600);
    background: var(--mist);
    color: var(--navy-900);
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.15rem;
  }
  .blocker-list { display: grid; gap: .75rem; }
  .blocker-item {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: .85rem;
    background: var(--mist);
  }
  .blocker-item h4 { margin: 0 0 .35rem; color: var(--navy-900); font-size: .98rem; }
  .blocker-item p { margin: 0; color: var(--muted); font-size: .88rem; }
  .equity-box {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 1.15rem;
    border-radius: .9rem;
    background: #edf5fd;
  }
  .equity-box span,
  .equity-box small { display: block; color: var(--muted); }
  .equity-box span { font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .equity-box strong { color: var(--navy-900); font-size: clamp(1.8rem, 5vw, 2.7rem); line-height: 1; }
  .equity-box small { margin-top: .3rem; font-size: .75rem; }
  .recommendation-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .75rem;
  }
  .recommendation-card {
    display: flex;
    flex-direction: column;
    min-height: 175px;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: .9rem;
    color: inherit;
    background: white;
    text-decoration: none;
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
  }
  .recommendation-card:hover {
    transform: translateY(-2px);
    border-color: #aebdcd;
    box-shadow: 0 12px 28px rgba(7, 24, 45, .09);
  }
  .recommendation-card span {
    color: var(--red-600);
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .recommendation-card h4 { margin: .35rem 0; color: var(--navy-900); font-size: 1rem; }
  .recommendation-card p { margin: 0 0 .85rem; color: var(--muted); font-size: .82rem; }
  .recommendation-card strong { margin-top: auto; color: var(--blue-600); font-size: .8rem; }
  .result-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
  }
  .contact-strip {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: clamp(1.25rem, 4vw, 2rem);
    border-radius: var(--radius-md);
    background: var(--sand);
  }
  .contact-strip h3 { margin-bottom: .4rem; }
  .contact-strip p { margin: 0; color: var(--muted); }
  .contact-buttons { display: flex; flex-wrap: wrap; gap: .6rem; }
  .privacy-footer { margin: .85rem 0 0; color: var(--muted); font-size: .76rem; text-align: center; }
  @media (max-width: 700px) {
    .option-grid,
    .option-grid.two-wide,
    .recommendation-grid,
    .contact-strip { grid-template-columns: 1fr; }
    .quiz-nav { align-items: stretch; }
    .quiz-nav .quiz-button { flex: 1; }
    .equity-box { grid-template-columns: 1fr; }
    .contact-buttons { display: grid; }
  }
  @media (max-width: 460px) {
    .quiz-card { padding: 1rem; }
    .quiz-nav { flex-direction: column-reverse; }
  }
</style>

<script is:inline>
  (function () {
    var app = document.getElementById('idealHomeQuiz');
    if (!app) return;

    var state = {
      ownRent: '',
      missing: [],
      oneThing: '',
      blockers: [],
      wantNumbers: null,
      homeValue: 450000,
      mortgageBalance: 225000,
      comfortPayment: 3000
    };

    var missingOptions = [
      'More space',
      'Better location',
      'Larger yard',
      'Less maintenance',
      'Better schools',
      'Home office',
      'Newer home',
      'More privacy',
      'Better layout',
      'Nothing — just curious'
    ];

    var blockerOptions = [
      'Interest rates',
      "Don't know what my home is worth",
      "Don't know what I can afford",
      'Inventory is too low',
      'Kids / school timing',
      'Need to sell first',
      'Too much uncertainty',
      "We haven't seriously considered moving",
      'Other'
    ];

    var blockerDetails = {
      'Interest rates': {
        reframe: 'The headline rate is only one part of the decision. The payment difference, available equity, price range, and timing all matter.',
        tool: {
          eyebrow: 'Compare loan terms',
          title: '30-Year vs. 15-Year Calculator',
          description: 'See the payment and total-interest tradeoff, including an optional extra-payment path.',
          href: '/tools/30-vs-15-calculator/'
        }
      },
      "Don't know what my home is worth": {
        reframe: 'A useful plan starts with a realistic value range, then subtracts selling costs, the loan balance, and the reserve you want to keep.',
        tool: {
          eyebrow: 'Estimate usable proceeds',
          title: 'Move-Up Mortgage Calculator',
          description: 'Turn an estimated sale price into a clearer view of usable proceeds and the next payment.',
          href: '/tools/move-up-calculator/'
        }
      },
      "Don't know what I can afford": {
        reframe: 'Start with a payment that feels comfortable, then work backward to a price range instead of beginning with a lender maximum.',
        tool: {
          eyebrow: 'Estimate buying power',
          title: 'Home Affordability Calculator',
          description: 'Translate a comfortable monthly budget into an estimated home-price range.',
          href: 'https://jasonknashville.github.io/What-Can-I-Afford-Calc/'
        }
      },
      'Inventory is too low': {
        reframe: 'Inventory varies sharply by neighborhood, price band, property type, and week. A focused search is more useful than the broad headline.',
        tool: {
          eyebrow: 'See current options',
          title: 'Search Middle Tennessee Homes',
          description: 'Look at current listings that fit the location and features you actually care about.',
          href: 'https://the-jason-kaczmarski-team-springfield-tn.remax.com/'
        }
      },
      'Kids / school timing': {
        reframe: 'School timing is a real constraint, but it can be planned around. The useful question is what waiting changes financially and logistically.',
        tool: {
          eyebrow: 'Compare the timeline',
          title: 'Move Now or Wait 12 Months',
          description: 'Compare a move today with waiting as rates, prices, and equity change.',
          href: 'https://jasonknashville.github.io/Move-Now-vs-Wait-12-Months/'
        }
      },
      'Need to sell first': {
        reframe: 'Selling first is common. The key is knowing the likely net proceeds and choosing a sequence that protects your cash and timing.',
        tool: {
          eyebrow: 'Plan the sequence',
          title: 'Move-Up Mortgage Calculator',
          description: 'Estimate net sale proceeds, reserves, and the payment on the next home.',
          href: '/tools/move-up-calculator/'
        }
      },
      'Too much uncertainty': {
        reframe: 'You do not need one giant yes-or-no decision. Separate value, payment, timing, and home priorities into smaller questions.',
        tool: {
          eyebrow: 'Start with the numbers',
          title: 'Move-Up Mortgage Calculator',
          description: 'Test the sale, rental, reserve, and next-payment assumptions privately.',
          href: '/tools/move-up-calculator/'
        }
      },
      "We haven't seriously considered moving": {
        reframe: 'That is a perfectly useful result. You now have a baseline for the features and questions that would matter if the idea becomes real.',
        tool: {
          eyebrow: 'Browse at your pace',
          title: 'Real Estate Planning Tools',
          description: 'Use only the calculator that matches the next question you want answered.',
          href: '/tools/'
        }
      },
      'Other': {
        reframe: 'Some obstacles do not fit neatly into a calculator. A short, no-pressure conversation can help separate the real constraint from the noise.',
        tool: {
          eyebrow: 'Talk it through',
          title: 'Contact Jason',
          description: 'Explain the situation in your own words and get a practical next step.',
          href: 'https://jasonk.remax.com/contact.php'
        }
      }
    };

    var stepIndex = 0;

    function steps() {
      var list = ['intro', 'ownRent', 'missing', 'oneThing', 'blockers'];
      if (state.ownRent === 'Own') {
        list.push('numbersGate');
        if (state.wantNumbers === true) list.push('numbers');
      }
      list.push('results');
      return list;
    }

    function questionSteps() {
      return steps().filter(function (key) {
        return key !== 'intro' && key !== 'results';
      });
    }

    function progress() {
      var list = steps();
      var current = list[stepIndex];
      var questions = questionSteps();
      var number = questions.indexOf(current) + 1;
      var percent = Math.round((Math.max(0, number - 1) / questions.length) * 100);
      return '<div class="quiz-progress">' +
        '<div class="quiz-progress-track"><div class="quiz-progress-fill" style="width:' + percent + '%"></div></div>' +
        '<div class="quiz-progress-label">Question ' + number + ' of ' + questions.length + '</div>' +
        '</div>';
    }

    function escapeHtml(value) {
      return String(value || '').replace(/[&<>"']/g, function (character) {
        return {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        }[character];
      });
    }

    function money(value) {
      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: 0
      }).format(Number(value) || 0);
    }

    function render() {
      var current = steps()[stepIndex];
      if (current === 'intro') renderIntro();
      if (current === 'ownRent') renderOwnRent();
      if (current === 'missing') renderMissing();
      if (current === 'oneThing') renderOneThing();
      if (current === 'blockers') renderBlockers();
      if (current === 'numbersGate') renderNumbersGate();
      if (current === 'numbers') renderNumbers();
      if (current === 'results') renderResults();
    }

    function renderIntro() {
      app.innerHTML =
        '<div class="quiz-intro">' +
          '<span class="eyebrow">Ideal-home clarity check</span>' +
          '<h2>A move becomes easier to evaluate when the questions are separated.</h2>' +
          '<p>Name what your current home is missing, identify every real obstacle, and get a short set of planning tools matched to your answers.</p>' +
          '<div class="quiz-intro-meta">About 60 seconds · No sign-in · Nothing is submitted</div>' +
          '<button class="quiz-button primary intro-button" id="startQuiz" type="button">Start the clarity check →</button>' +
        '</div>';
      document.getElementById('startQuiz').addEventListener('click', next);
    }

    function questionShell(label, title, help, body, options) {
      options = options || {};
      app.innerHTML =
        progress() +
        '<div class="quiz-card">' +
          '<span class="question-label">' + label + '</span>' +
          '<h2>' + title + '</h2>' +
          (help ? '<p class="question-help">' + help + '</p>' : '') +
          body +
          '<div class="quiz-nav">' +
            '<button class="quiz-button secondary" type="button" id="backButton">← Back</button>' +
            '<button class="quiz-button primary" type="button" id="nextButton">' + (options.nextLabel || 'Next →') + '</button>' +
          '</div>' +
          (options.skipLabel ? '<button class="skip-button" type="button" id="skipButton">' + options.skipLabel + '</button>' : '') +
        '</div>';

      document.getElementById('backButton').addEventListener('click', previous);
      document.getElementById('nextButton').addEventListener('click', next);
      if (options.skipLabel) {
        document.getElementById('skipButton').addEventListener('click', next);
      }
    }

    function optionMarkup(value, selected) {
      return '<button class="quiz-option' + (selected ? ' selected' : '') + '" type="button" data-value="' + escapeHtml(value) + '">' +
        '<span class="option-check" aria-hidden="true"></span>' +
        '<span>' + escapeHtml(value) + '</span>' +
      '</button>';
    }

    function renderOwnRent() {
      questionShell(
        'Question 1',
        'Do you own or rent right now?',
        'This changes which financial questions are useful.',
        '<div class="option-grid two-wide">' +
          optionMarkup('Own', state.ownRent === 'Own') +
          optionMarkup('Rent', state.ownRent === 'Rent') +
        '</div>'
      );

      var nextButton = document.getElementById('nextButton');
      nextButton.disabled = !state.ownRent;
      app.querySelectorAll('.quiz-option').forEach(function (button) {
        button.addEventListener('click', function () {
          state.ownRent = button.getAttribute('data-value');
          if (state.ownRent === 'Rent') {
            state.wantNumbers = null;
          }
          app.querySelectorAll('.quiz-option').forEach(function (item) {
            item.classList.toggle('selected', item === button);
          });
          nextButton.disabled = false;
        });
      });
    }

    function renderMissing() {
      var options = missingOptions.map(function (option) {
        return optionMarkup(option, state.missing.indexOf(option) > -1);
      }).join('');

      questionShell(
        'Question 2',
        "What's missing from your current home?",
        'Choose up to three. These are priorities, not a commitment to move.',
        '<div class="option-grid">' + options + '</div>' +
        '<p class="selection-note" id="missingNote">Choose up to 3</p>',
        { skipLabel: 'Skip this question' }
      );

      app.querySelectorAll('.quiz-option').forEach(function (button) {
        button.addEventListener('click', function () {
          var value = button.getAttribute('data-value');
          var index = state.missing.indexOf(value);
          var note = document.getElementById('missingNote');

          if (index > -1) {
            state.missing.splice(index, 1);
            button.classList.remove('selected');
          } else if (state.missing.length < 3) {
            if (value === 'Nothing — just curious') state.missing = [];
            if (value !== 'Nothing — just curious') {
              state.missing = state.missing.filter(function (item) {
                return item !== 'Nothing — just curious';
              });
            }
            state.missing.push(value);
            renderMissing();
            return;
          } else {
            note.textContent = 'You already chose three. Remove one to swap it.';
            note.classList.add('warning');
            return;
          }

          note.textContent = 'Choose up to 3';
          note.classList.remove('warning');
        });
      });
    }

    function renderOneThing() {
      questionShell(
        'Question 3',
        'If you could change one thing tomorrow, what would it be?',
        'Optional, but this answer often reveals more than a feature checklist.',
        '<textarea class="quiz-textarea" id="oneThing" placeholder="A first-floor primary. A real garage. A shorter commute. A kitchen where everyone can gather.">' +
          escapeHtml(state.oneThing) +
        '</textarea>',
        { skipLabel: 'Skip this question' }
      );

      document.getElementById('oneThing').addEventListener('input', function (event) {
        state.oneThing = event.target.value;
      });
    }

    function renderBlockers() {
      var options = blockerOptions.map(function (option) {
        return optionMarkup(option, state.blockers.indexOf(option) > -1);
      }).join('');

      questionShell(
        'Question 4',
        "What's actually stopping you from making a move?",
        'Select every answer that applies. Your result will address all of them.',
        '<div class="option-grid">' + options + '</div>' +
        '<p class="selection-note">Choose as many as apply</p>',
        { nextLabel: state.ownRent === 'Own' ? 'Next →' : 'See my results →', skipLabel: "Nothing is stopping me" }
      );

      app.querySelectorAll('.quiz-option').forEach(function (button) {
        button.addEventListener('click', function () {
          var value = button.getAttribute('data-value');
          var index = state.blockers.indexOf(value);
          if (index > -1) {
            state.blockers.splice(index, 1);
            button.classList.remove('selected');
          } else {
            state.blockers.push(value);
            button.classList.add('selected');
          }
        });
      });
    }

    function renderNumbersGate() {
      questionShell(
        'Optional numbers',
        'Want a rough sense of your gross equity?',
        'This is before selling costs, repairs, moving expenses, and the cash reserve you want to keep.',
        '<div class="option-grid two-wide">' +
          optionMarkup('Yes, show me rough numbers', state.wantNumbers === true) +
          optionMarkup('No thanks, skip it', state.wantNumbers === false) +
        '</div>' +
        '<p class="selection-note">Nothing is saved or submitted.</p>',
        { nextLabel: 'Continue →' }
      );

      var nextButton = document.getElementById('nextButton');
      nextButton.disabled = state.wantNumbers === null;
      app.querySelectorAll('.quiz-option').forEach(function (button) {
        button.addEventListener('click', function () {
          state.wantNumbers = button.getAttribute('data-value') === 'Yes, show me rough numbers';
          app.querySelectorAll('.quiz-option').forEach(function (item) {
            item.classList.toggle('selected', item === button);
          });
          nextButton.disabled = false;
        });
      });
    }

    function rangeMarkup(label, key, min, max, step) {
      return '<div class="range-row">' +
        '<div class="range-heading"><span>' + label + '</span><strong id="value-' + key + '">' + money(state[key]) + '</strong></div>' +
        '<input id="range-' + key + '" type="range" min="' + min + '" max="' + max + '" step="' + step + '" value="' + state[key] + '">' +
      '</div>';
    }

    function renderNumbers() {
      questionShell(
        'Optional numbers',
        'Use the closest rough estimates.',
        'The result will show gross equity. The Move-Up Calculator can then estimate selling costs, reserves, and usable proceeds.',
        '<div class="range-list">' +
          rangeMarkup('Estimated current-home value', 'homeValue', 100000, 2000000, 25000) +
          rangeMarkup('Mortgage balance remaining', 'mortgageBalance', 0, 1500000, 25000) +
          rangeMarkup('Comfortable total monthly housing payment', 'comfortPayment', 1000, 10000, 250) +
        '</div>',
        { nextLabel: 'See my results →' }
      );

      ['homeValue', 'mortgageBalance', 'comfortPayment'].forEach(function (key) {
        document.getElementById('range-' + key).addEventListener('input', function (event) {
          state[key] = Number(event.target.value);
          document.getElementById('value-' + key).textContent = money(state[key]);
        });
      });
    }

    function recommendationList() {
      var items = [];
      state.blockers.forEach(function (blocker) {
        var detail = blockerDetails[blocker];
        if (detail) items.push(detail.tool);
      });

      if (state.ownRent === 'Own' && state.wantNumbers === true) {
        items.unshift({
          eyebrow: 'Use your rough equity',
          title: 'Move-Up Mortgage Calculator',
          description: 'Subtract selling costs and reserves, then estimate the payment on a next home.',
          href: '/tools/move-up-calculator/'
        });
      }

      if (state.ownRent === 'Rent' && !state.blockers.length) {
        items.push({
          eyebrow: 'Start with buying power',
          title: 'Home Affordability Calculator',
          description: 'Estimate a home price and payment range that fits your monthly budget.',
          href: 'https://jasonknashville.github.io/What-Can-I-Afford-Calc/'
        });
      }

      if (!items.length) {
        items.push({
          eyebrow: 'Explore the options',
          title: 'Real Estate Planning Tools',
          description: 'Choose the calculator that matches the next question you want answered.',
          href: '/tools/'
        });
      }

      var seen = {};
      return items.filter(function (item) {
        if (seen[item.href]) return false;
        seen[item.href] = true;
        return true;
      }).slice(0, 4);
    }

    function blockersMarkup() {
      if (!state.blockers.length) {
        return '<p>You did not identify a specific blocker. That may mean the next step is simply deciding whether the home priorities above matter enough to explore.</p>';
      }

      return '<div class="blocker-list">' + state.blockers.map(function (blocker) {
        var detail = blockerDetails[blocker] || blockerDetails.Other;
        return '<article class="blocker-item">' +
          '<h4>' + escapeHtml(blocker) + '</h4>' +
          '<p>' + escapeHtml(detail.reframe) + '</p>' +
        '</article>';
      }).join('') + '</div>';
    }

    function recommendationsMarkup() {
      return recommendationList().map(function (item) {
        var external = item.href.indexOf('http') === 0;
        return '<a class="recommendation-card" href="' + item.href + '"' +
          (external ? ' target="_blank" rel="noopener"' : '') +
          ' data-recommendation="' + escapeHtml(item.title) + '">' +
            '<span>' + escapeHtml(item.eyebrow) + '</span>' +
            '<h4>' + escapeHtml(item.title) + '</h4>' +
            '<p>' + escapeHtml(item.description) + '</p>' +
            '<strong>Open this tool →</strong>' +
          '</a>';
      }).join('');
    }

    function resultSummary() {
      var priorityCount = state.missing.filter(function (item) {
        return item !== 'Nothing — just curious';
      }).length;
      var blockerCount = state.blockers.length;

      if (!priorityCount && !blockerCount) {
        return 'You may be early in the process, which is useful. There is no need to manufacture urgency; keep the tools for the moment a specific question appears.';
      }
      if (blockerCount > 1) {
        return 'This is not one obstacle. You named ' + blockerCount + ' separate planning questions, so the clearest path is to solve them one at a time instead of treating the move as one giant decision.';
      }
      if (blockerCount === 1) {
        return 'You identified one main planning question. Put a real number or next action beside it before deciding whether a move makes sense.';
      }
      return 'Your answers are more about what you want from a home than what is stopping you. The next step is deciding whether those priorities are worth pricing out.';
    }

    function renderResults() {
      var priorities = state.missing.filter(function (item) {
        return item !== 'Nothing — just curious';
      });
      var prioritiesHtml = priorities.length
        ? '<div class="priority-tags">' + priorities.map(function (item) {
            return '<span class="priority-tag">' + escapeHtml(item) + '</span>';
          }).join('') + '</div>'
        : '<p>No feature priorities selected.</p>';

      var oneThingHtml = state.oneThing.trim()
        ? '<blockquote class="one-thing">“' + escapeHtml(state.oneThing.trim()) + '”</blockquote>'
        : '';

      var equityHtml = '';
      if (state.ownRent === 'Own' && state.wantNumbers === true) {
        var grossEquity = Math.max(0, state.homeValue - state.mortgageBalance);
        equityHtml =
          '<section class="result-panel">' +
            '<h3>Your rough numbers</h3>' +
            '<div class="equity-box">' +
              '<div>' +
                '<span>Estimated gross equity</span>' +
                '<small>Home value minus mortgage balance. Selling costs and your preferred cash reserve are not yet deducted.</small>' +
              '</div>' +
              '<strong>' + money(grossEquity) + '</strong>' +
            '</div>' +
            '<p class="selection-note">Comfortable monthly housing payment entered: ' + money(state.comfortPayment) + '</p>' +
          '</section>';
      }

      app.innerHTML =
        '<div class="result-stack">' +
          '<section class="result-hero">' +
            '<span class="eyebrow">Your clarity check</span>' +
            '<h2>Here is what your answers point to.</h2>' +
            '<p>' + escapeHtml(resultSummary()) + '</p>' +
          '</section>' +
          '<section class="result-panel">' +
            '<h3>The home you would choose</h3>' +
            prioritiesHtml +
            oneThingHtml +
          '</section>' +
          '<section class="result-panel">' +
            '<h3>Every obstacle you named</h3>' +
            '<p>None of these has been discarded or reduced to a single “primary” blocker.</p>' +
            blockersMarkup() +
          '</section>' +
          equityHtml +
          '<section class="result-panel">' +
            '<h3>Best next tools for these answers</h3>' +
            '<p>Start with the one that answers the most immediate question. You do not need to use all of them.</p>' +
            '<div class="recommendation-grid">' + recommendationsMarkup() + '</div>' +
          '</section>' +
          '<div class="contact-strip">' +
            '<div>' +
              '<h3>Prefer a conversation?</h3>' +
              '<p>Talk through the priorities and blockers without needing every number figured out first.</p>' +
            '</div>' +
            '<div class="contact-buttons">' +
              '<a class="quiz-button primary" href="https://jasonk.remax.com/contact.php" data-contact="Jason">Contact Jason</a>' +
              '<a class="quiz-button secondary" href="https://ashlyn-sheppard.remax.com/contact.php" data-contact="Ashlyn">Contact Ashlyn</a>' +
            '</div>' +
          '</div>' +
          '<div class="result-actions">' +
            '<button class="quiz-button secondary" type="button" id="copyResults">Copy results</button>' +
            '<button class="quiz-button secondary" type="button" id="restartQuiz">Start over</button>' +
            '<a class="quiz-button secondary" href="/tools/">See all tools</a>' +
          '</div>' +
          '<p class="privacy-footer">Your answers were processed in this browser and were not submitted. Planning estimates are not an appraisal, loan quote, or guarantee.</p>' +
        '</div>';

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'ideal_home_quiz_complete',
        ownership: state.ownRent,
        priority_count: priorities.length,
        blocker_count: state.blockers.length,
        included_numbers: state.wantNumbers === true
      });

      app.querySelectorAll('[data-recommendation]').forEach(function (link) {
        link.addEventListener('click', function () {
          window.dataLayer.push({
            event: 'ideal_home_quiz_recommendation_click',
            recommendation: link.getAttribute('data-recommendation')
          });
        });
      });

      app.querySelectorAll('[data-contact]').forEach(function (link) {
        link.addEventListener('click', function () {
          window.dataLayer.push({
            event: 'ideal_home_quiz_contact_click',
            contact: link.getAttribute('data-contact')
          });
        });
      });

      document.getElementById('restartQuiz').addEventListener('click', function () {
        state = {
          ownRent: '',
          missing: [],
          oneThing: '',
          blockers: [],
          wantNumbers: null,
          homeValue: 450000,
          mortgageBalance: 225000,
          comfortPayment: 3000
        };
        stepIndex = 0;
        render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      document.getElementById('copyResults').addEventListener('click', copyResults);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function copyResults() {
      var lines = [
        'My Ideal Home Clarity Check',
        '',
        'Current situation: ' + (state.ownRent || 'Not answered'),
        'Home priorities: ' + (state.missing.join(', ') || 'None selected'),
        'One thing I would change: ' + (state.oneThing.trim() || 'Not answered'),
        'Planning blockers: ' + (state.blockers.join(', ') || 'None selected')
      ];

      if (state.ownRent === 'Own' && state.wantNumbers === true) {
        lines.push('Estimated gross equity: ' + money(Math.max(0, state.homeValue - state.mortgageBalance)));
        lines.push('Comfortable monthly housing payment: ' + money(state.comfortPayment));
      }

      lines.push('');
      lines.push('Planning tools: ' + window.location.origin + '/tools/');

      var text = lines.join('\n');
      var button = document.getElementById('copyResults');
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(function () {
          button.textContent = 'Results copied';
          window.setTimeout(function () { button.textContent = 'Copy results'; }, 1800);
        }).catch(function () {
          window.prompt('Copy your results:', text);
        });
      } else {
        window.prompt('Copy your results:', text);
      }
    }

    function next() {
      var currentSteps = steps();
      if (stepIndex < currentSteps.length - 1) {
        stepIndex += 1;
        render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function previous() {
      if (stepIndex > 0) {
        stepIndex -= 1;
        render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    render();
  })();
</script>
