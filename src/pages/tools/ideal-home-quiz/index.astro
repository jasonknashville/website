  <style is:global>
    :root{
      --remax-red:#DC1C2E;
      --remax-blue:#003DA5;
      --remax-blue-2:#0356C9;
      --gold:#C9A227;
      --ink:#1A2B45;
      --slate:#566479;
      --bg:#F4F6FA;
      --card:#FFFFFF;
      --line:#E4E9F2;
      --good:#1F9D6B;
