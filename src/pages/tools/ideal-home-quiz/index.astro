    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{
      font-family:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
      color:var(--ink);
      background:var(--bg);
      line-height:1.55;
      -webkit-font-smoothing:antialiased;
    }
    h1,h2,h3{font-family:'Playfair Display',Georgia,serif;line-height:1.15;font-weight:700}
    button,input,textarea{font:inherit}

    .ihq-header{
      position:sticky;top:0;z-index:50;
      background:var(--remax-red);
      color:#fff;
      box-shadow:0 2px 12px rgba(0,0,0,.12);
    }
    .ihq-header-inner{
      max-width:760px;margin:0 auto;padding:12px 20px;
      display:flex;align-items:center;justify-content:space-between;gap:12px;
    }
    .ihq-brand{display:flex;align-items:center;gap:12px;min-width:0}
    .ihq-brand-text{font-weight:700;font-size:.95rem;letter-spacing:.2px;white-space:nowrap}
    .ihq-brand-text small{display:block;font-weight:500;opacity:.85;font-size:.72rem;letter-spacing:.4px}
    .ihq-header a{color:#fff;text-decoration:none;font-weight:600;font-size:.85rem;opacity:.95}
    .ihq-header a:hover{opacity:1;text-decoration:underline}

    .ihq-wrap{max-width:760px;margin:0 auto;padding:28px 20px 60px;min-height:calc(100vh - 260px)}
    .ihq-card{
      background:var(--card);border:1px solid var(--line);
      border-radius:var(--radius);box-shadow:var(--shadow);
      padding:32px;
    }
    @media(max-width:560px){.ihq-card{padding:22px}}

    .ihq-progress{margin-bottom:24px}
    .ihq-progress-bar{height:8px;background:#E9EEF6;border-radius:99px;overflow:hidden}
    .ihq-progress-fill{height:100%;width:0;background:linear-gradient(90deg,var(--remax-blue),var(--remax-blue-2));border-radius:99px;transition:width .45s cubic-bezier(.4,0,.2,1)}
    .ihq-progress-label{margin-top:8px;font-size:.78rem;color:var(--slate);font-weight:600;letter-spacing:.3px}

    .ihq-hero{
      background:linear-gradient(135deg,var(--remax-blue) 0%,var(--remax-blue-2) 100%);
      color:#fff;border-radius:var(--radius);padding:40px 34px;box-shadow:var(--shadow);
    }
    .ihq-eyebrow{
      display:inline-block;font-size:.74rem;font-weight:700;letter-spacing:1.6px;
      text-transform:uppercase;color:var(--gold);margin-bottom:14px;
    }
    .ihq-hero h1{font-size:2rem;margin-bottom:14px}
    .ihq-hero p{font-size:1.05rem;opacity:.94;margin-bottom:10px;max-width:54ch}
    .ihq-hero .ihq-sub{opacity:.8;font-size:.95rem;margin-top:18px}
    @media(max-width:560px){.ihq-hero{padding:30px 22px}.ihq-hero h1{font-size:1.6rem}}

    .ihq-step{animation:ihqFade .4s ease}
    @keyframes ihqFade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
    .ihq-q-num{font-size:.78rem;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--remax-red);margin-bottom:8px}
    .ihq-q-title{font-size:1.45rem;margin-bottom:6px}
    .ihq-q-help{color:var(--slate);font-size:.92rem;margin-bottom:22px}
    @media(max-width:560px){.ihq-q-title{font-size:1.25rem}}

    .ihq-options{display:grid;gap:10px}
    .ihq-options.two,.ihq-options.grid{grid-template-columns:1fr 1fr}
    @media(max-width:480px){.ihq-options.two,.ihq-options.grid{grid-template-columns:1fr}}
    .ihq-opt{
      display:flex;align-items:center;gap:12px;
      padding:15px 16px;border:1.5px solid var(--line);border-radius:12px;
      background:#fff;cursor:pointer;font-weight:500;font-size:.98rem;
      transition:border-color .15s,background .15s,transform .08s;
      text-align:left;width:100%;color:var(--ink);
    }
    .ihq-opt:hover{border-color:#B9C6DC;background:#FAFBFE}
    .ihq-opt:active{transform:scale(.99)}
    .ihq-opt.selected{border-color:var(--remax-blue);background:#EEF4FF}
    .ihq-check{
      width:22px;height:22px;border-radius:6px;border:2px solid #C6D0E0;flex:none;
      display:grid;place-items:center;transition:all .15s;
    }
    .ihq-opt.round .ihq-check{border-radius:50%}
    .ihq-opt.selected .ihq-check{background:var(--remax-blue);border-color:var(--remax-blue)}
    .ihq-check svg{width:13px;height:13px;opacity:0;transition:opacity .15s}
    .ihq-opt.selected .ihq-check svg{opacity:1}
    .ihq-cap-note{margin-top:14px;font-size:.82rem;color:var(--slate);text-align:center}
    .ihq-cap-note.warn{color:var(--remax-red);font-weight:600}

    .ihq-textarea{
      width:100%;border:1.5px solid var(--line);border-radius:12px;
      padding:14px 15px;font-family:inherit;font-size:1rem;color:var(--ink);background:#fff;
      transition:border-color .15s;min-height:96px;resize:vertical;
    }
    .ihq-textarea:focus{outline:none;border-color:var(--remax-blue)}

    .ihq-slider-block{margin-bottom:26px}
    .ihq-slider-top{display:flex;justify-content:space-between;align-items:baseline;gap:18px;margin-bottom:10px}
    .ihq-slider-label{font-weight:600;font-size:.98rem}
    .ihq-slider-val{font-family:'Playfair Display',serif;font-weight:700;font-size:1.3rem;color:var(--remax-blue);white-space:nowrap}
    input[type=range]{
      -webkit-appearance:none;appearance:none;width:100%;height:6px;border-radius:99px;
      background:#E2E9F4;outline:none;
    }
    input[type=range]::-webkit-slider-thumb{
      -webkit-appearance:none;appearance:none;width:26px;height:26px;border-radius:50%;
      background:var(--remax-red);cursor:pointer;border:3px solid #fff;box-shadow:0 2px 8px rgba(220,28,46,.4);
    }
    input[type=range]::-moz-range-thumb{
      width:20px;height:20px;border-radius:50%;background:var(--remax-red);cursor:pointer;
      border:3px solid #fff;box-shadow:0 2px 8px rgba(220,28,46,.4);
    }

    .ihq-nav{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-top:28px}
    .ihq-btn{
      display:inline-flex;align-items:center;justify-content:center;
      font-family:inherit;font-weight:700;font-size:1rem;border:none;cursor:pointer;
      padding:14px 28px;border-radius:12px;transition:transform .08s,box-shadow .15s,background .15s;
      text-decoration:none;
    }
    .ihq-btn:active{transform:translateY(1px)}
    .ihq-btn-primary{background:var(--remax-red);color:#fff;box-shadow:0 6px 18px rgba(220,28,46,.28)}
    .ihq-btn-primary:hover{background:#c1162a}
    .ihq-btn-primary:disabled{background:#D9B3B8;cursor:not-allowed;box-shadow:none}
    .ihq-btn-ghost{background:transparent;color:var(--slate);padding:14px 8px;box-shadow:none}
    .ihq-btn-ghost:hover{color:var(--ink)}
    .ihq-btn-blue{background:var(--remax-blue);color:#fff;box-shadow:0 6px 18px rgba(0,61,165,.25)}
    .ihq-btn-blue:hover{background:#00347f}
    .ihq-btn-full{width:100%;text-align:center}
    .ihq-skip{display:block;text-align:center;margin-top:14px;background:none;border:none;color:var(--slate);font-family:inherit;font-size:.88rem;cursor:pointer;text-decoration:underline}
    .ihq-skip:hover{color:var(--ink)}

    .ihq-result-eyebrow{font-size:.78rem;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(--gold);text-align:center;margin-bottom:10px}
    .ihq-result h2{font-size:1.9rem;text-align:center;margin-bottom:16px}
    .ihq-result-summary{text-align:center;color:var(--slate);margin-bottom:22px;max-width:48ch;margin-left:auto;margin-right:auto}
    @media(max-width:560px){.ihq-result h2{font-size:1.5rem}}
    .ihq-reflect{background:#F7F9FD;border:1px solid var(--line);border-left:4px solid var(--remax-blue);border-radius:12px;padding:18px 20px;margin-bottom:16px}
    .ihq-reflect h3{font-size:1.05rem;margin-bottom:6px;font-family:'DM Sans',sans-serif;font-weight:700}
    .ihq-reflect p{color:var(--slate);font-size:.95rem}
    .ihq-reflect .ihq-quote{font-style:italic;color:var(--ink);font-size:1.05rem;font-weight:500}
    .ihq-equity{background:linear-gradient(135deg,var(--remax-blue),var(--remax-blue-2));color:#fff;border-radius:12px;padding:22px;margin:8px 0 16px;text-align:center}
    .ihq-equity-num{font-family:'Playfair Display',serif;font-size:2.2rem;font-weight:800;margin:4px 0}
    .ihq-equity small{opacity:.85;font-size:.82rem;display:block;margin-top:6px}
    .ihq-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
    .ihq-tag{background:#EEF4FF;color:var(--remax-blue);border:1px solid #D5E2F7;border-radius:99px;padding:5px 13px;font-size:.85rem;font-weight:600}
    .ihq-tool-list{display:grid;gap:10px;margin-top:12px}
    .ihq-tool{
      display:flex;justify-content:space-between;align-items:center;gap:16px;
      padding:13px 14px;border:1.5px solid #D5E2F7;border-radius:12px;
      background:#fff;color:var(--ink);text-decoration:none;font-weight:600;
      transition:border-color .15s,background .15s,transform .08s;
    }
    .ihq-tool:hover{border-color:var(--remax-blue);background:#EEF4FF}
    .ihq-tool:active{transform:scale(.99)}
    .ihq-tool span{color:var(--remax-blue);font-size:1.1rem}
    .ihq-optin{margin-top:22px;border-top:1px dashed var(--line);padding-top:24px}
    .ihq-optin h3{font-family:'Playfair Display',serif;font-size:1.3rem;text-align:center;margin-bottom:6px}
    .ihq-optin p{text-align:center;color:var(--slate);font-size:.92rem;margin-bottom:18px;max-width:46ch;margin-left:auto;margin-right:auto}
    .ihq-contact-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .ihq-result-actions{display:flex;justify-content:center;flex-wrap:wrap;gap:12px;margin-top:20px}
    .ihq-result-actions .ihq-btn{font-size:.88rem;padding:10px 16px}
    .ihq-privacy{text-align:center;font-size:.76rem;color:#8a95a8;margin-top:12px}

    .ihq-footer{background:var(--remax-blue);color:#fff;margin-top:50px}
    .ihq-footer-inner{max-width:760px;margin:0 auto;padding:28px 20px;text-align:center}
    .ihq-footer strong{display:block;font-size:1rem;margin-bottom:4px}
    .ihq-footer p{opacity:.8;font-size:.82rem;margin:4px 0}
    .ihq-footer a{color:#fff;font-weight:600}
    .ihq-disclaimer{opacity:.6;font-size:.72rem;margin-top:14px;line-height:1.5}
    @media(max-width:480px){
      .ihq-contact-actions{grid-template-columns:1fr}
      .ihq-slider-top{align-items:flex-start}
    }
    @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
  </style>
</head>
<body>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MH9X9NGV" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <header class="ihq-header">
    <div class="ihq-header-inner">
      <div class="ihq-brand">
        <div class="ihq-brand-text">RE/MAX 1st Choice<small>Jason Kaczmarski Team</small></div>
