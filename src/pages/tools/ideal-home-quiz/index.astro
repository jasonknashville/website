      <a href="https://jasonk.remax.com/contact.php">Contact</a>
    </div>
  </header>

  <main class="ihq-wrap">
    <div id="ihq-app"></div>
    <noscript>
      <div class="ihq-card">
        <h2>JavaScript is needed for this quiz.</h2>
        <p>Please visit the planning tools page instead.</p>
      </div>
    </noscript>
  </main>

  <footer class="ihq-footer">
    <div class="ihq-footer-inner">
      <strong>RE/MAX 1st Choice</strong>
      <p>Jason Kaczmarski Team</p>
      <p><a href="tel:6153847355">615-384-7355</a></p>
      <p>Serving Nashville &amp; Middle Tennessee</p>
      <p><a href="https://jasonk.remax.com/contact.php">Get in touch</a></p>
      <p class="ihq-disclaimer">Information is deemed reliable but not guaranteed. Data sourced in part from Realtracs. Any estimates provided by this tool are rough, for educational purposes only, and are not an appraisal, loan approval, or offer. Each RE/MAX office independently owned and operated.</p>
    </div>
  </footer>

  <script is:inline>
    (function(){
      'use strict';

      var state = {
        ownRent: null,
        missing: [],
        oneThing: '',
        blockers: [],
        wantNumbers: null,
        homeValue: 400000,
        mortgageBalance: 200000,
        comfortPayment: 2500
      };

      var missingOptions = ['More space','Better location','Larger yard','Less maintenance','Better schools','Home office','Newer home','More privacy','Better layout','Nothing — just curious'];
      var blockerOptions = ['Interest rates',"Don't know what my home is worth","Don't know what I can afford",'Inventory is too low','Kids / school timing','Need to sell first','Too much uncertainty',"We haven't seriously considered moving",'Other'];

      var blockerDetails = {
        'Interest rates': {
          reframe: 'Rates move. Your equity, payment, and timing usually matter more than the headline number alone.',
          tool: ['30-Year vs. 15-Year Calculator','/tools/30-vs-15-calculator/']
        },
        "Don't know what my home is worth": {
          reframe: 'That is one of the easiest questions to solve. A realistic value range takes a lot of guesswork out of the rest.',
          tool: ['Move-Up Mortgage Calculator','/tools/move-up-calculator/']
        },
        "Don't know what I can afford": {
          reframe: 'Start with a payment that feels comfortable, then work backward to a price range instead of beginning with a lender maximum.',
          tool: ['Home Affordability Calculator','https://jasonknashville.github.io/What-Can-I-Afford-Calc/']
        },
        'Inventory is too low': {
          reframe: 'Inventory changes by neighborhood, price, property type, and week. A focused search is more useful than the broad headline.',
          tool: ['Search Middle Tennessee Homes','https://the-jason-kaczmarski-team-springfield-tn.remax.com/']
        },
        'Kids / school timing': {
          reframe: 'Plenty of moves get built around the school calendar. The useful question is what waiting changes financially and logistically.',
          tool: ['Move Now or Wait 12 Months','https://jasonknashville.github.io/Move-Now-vs-Wait-12-Months/']
        },
        'Need to sell first': {
          reframe: 'Selling first is the most common path there is. The key is knowing the likely proceeds and choosing a clean sequence.',
          tool: ['Move-Up Mortgage Calculator','/tools/move-up-calculator/']
        },
        'Too much uncertainty': {
          reframe: 'Clarity comes from separating value, payment, timing, and home priorities into smaller questions.',
          tool: ['Real Estate Planning Tools','/tools/']
        },
        "We haven't seriously considered moving": {
          reframe: 'No pressure at all. Now you have a baseline for whenever the question comes up.',
          tool: ['Real Estate Planning Tools','/tools/']
        },
        'Other': {
          reframe: 'Some obstacles do not fit neatly into a calculator. A short conversation can help separate the real constraint from the noise.',
          tool: ['Contact Jason','https://jasonk.remax.com/contact.php']
        }
      };

      var app = document.getElementById('ihq-app');
      var idx = 0;
      var check = '<svg viewBox="0 0 24 24" fill="none"><path d="M5 12l5 5L20 7" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';

      function steps(){
        var base = ['intro','ownRent','missing','oneThing','blockers','numbersGate'];
        if(state.wantNumbers === true) base.push('numbers');
        base.push('results');
        return base;
      }
      function totalForBar(){return steps().filter(function(key){return key !== 'intro' && key !== 'results';}).length}
      function answeredForBar(){return steps().slice(0,idx).filter(function(key){return key !== 'intro' && key !== 'results';}).length}
      function money(value){return '$' + Number(value).toLocaleString('en-US')}
      function escapeHtml(value){return String(value || '').replace(/[&<>"']/g,function(character){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[character]})}
      function element(html){var wrapper=document.createElement('div');wrapper.innerHTML=html.trim();return wrapper.firstChild}
      function progressHtml(){
        var total=totalForBar();
        var answered=answeredForBar();
        var percent=Math.round((answered/total)*100);
        return '<div class="ihq-progress"><div class="ihq-progress-bar"><div class="ihq-progress-fill" style="width:'+percent+'%"></div></div><div class="ihq-progress-label">Question '+Math.min(answered+1,total)+' of '+total+'</div></div>';
      }
      function render(){
        var key=steps()[idx];
        if(key === 'intro') renderIntro();
        if(key === 'ownRent') renderOwnRent();
        if(key === 'missing') renderMissing();
        if(key === 'oneThing') renderOneThing();
        if(key === 'blockers') renderBlockers();
        if(key === 'numbersGate') renderNumbersGate();
        if(key === 'numbers') renderNumbers();
        if(key === 'results') renderResults();
      }
      function renderIntro(){
        app.innerHTML='';
        var node=element('<div class="ihq-step"><div class="ihq-hero"><span class="ihq-eyebrow">A 60-second clarity check</span><h1>How far are you from your <em>ideal</em> home?</h1><p>Not your current home. The one you would choose if you were starting from scratch today.</p><p>Most homeowners are not looking to move—but plenty are not living in the home they would actually pick. This takes about a minute, no pressure, no obligation.</p><div class="ihq-sub">A few quick questions &middot; The money part is optional</div></div><button class="ihq-btn ihq-btn-primary ihq-btn-full" style="margin-top:18px" id="ihq-start">Let\'s get you clarity &rarr;</button></div>');
        app.appendChild(node);
        document.getElementById('ihq-start').onclick=next;
      }
      function questionShell(number,title,help,bodyHtml,options){
        options=options||{};
        app.innerHTML='';
        var node=element('<div class="ihq-step">'+progressHtml()+'<div class="ihq-card"><div class="ihq-q-num">'+number+'</div><h2 class="ihq-q-title">'+title+'</h2>'+(help?'<p class="ihq-q-help">'+help+'</p>':'')+'<div>'+bodyHtml+'</div><div class="ihq-nav"><button class="ihq-btn ihq-btn-ghost" id="ihq-back">&larr; Back</button><button class="ihq-btn ihq-btn-primary" id="ihq-next">'+(options.nextLabel||'Next')+'</button></div>'+(options.skip?'<button class="ihq-skip" id="ihq-skip">'+options.skip+'</button>':'')+'</div></div>');
        app.appendChild(node);
        document.getElementById('ihq-back').onclick=previous;
        document.getElementById('ihq-next').onclick=next;
        if(options.skip) document.getElementById('ihq-skip').onclick=next;
      }
      function optionHtml(value,selected,round){return '<button class="ihq-opt'+(round?' round':'')+(selected?' selected':'')+'" data-v="'+escapeHtml(value)+'"><span class="ihq-check">'+check+'</span>'+escapeHtml(value)+'</button>'}
      function renderOwnRent(){
        questionShell('Question 1','Do you own or rent right now?','', '<div class="ihq-options two">'+optionHtml('Own',state.ownRent==='Own',true)+optionHtml('Rent',state.ownRent==='Rent',true)+'</div>');
        var nextButton=document.getElementById('ihq-next');
        nextButton.disabled=!state.ownRent;
        bindSingle('ownRent',function(){nextButton.disabled=!state.ownRent});
      }
      function renderMissing(){
        var html='<div class="ihq-options grid">'+missingOptions.map(function(option){return optionHtml(option,state.missing.indexOf(option)>-1,false)}).join('')+'</div><div class="ihq-cap-note" id="ihq-cap">Choose up to 3</div>';
        questionShell('Question 2',"What's missing from your current home?","Pick the things you would fix if you could. Up to three.",html,{skip:'Skip this one'});
        bindMulti('missing',3,'ihq-cap','Choose up to 3');
      }
      function renderOneThing(){
        questionShell('Question 3','If you could change ONE thing tomorrow, what would it be?','Optional—but this is usually the most telling answer.','<textarea class="ihq-textarea" id="ihq-onething" placeholder="e.g. A first-floor primary. A real garage. Not hearing the neighbor\'s dog. A bigger kitchen.">'+escapeHtml(state.oneThing)+'</textarea>',{skip:'Skip this one'});
        document.getElementById('ihq-onething').oninput=function(event){state.oneThing=event.target.value};
      }
      function renderBlockers(){
        var html='<div class="ihq-options grid">'+blockerOptions.map(function(option){return optionHtml(option,state.blockers.indexOf(option)>-1,false)}).join('')+'</div><div class="ihq-cap-note">Select any that apply</div>';
        questionShell('Question 4',"What's actually stopping you from making a move?","Most agents never ask this. Be honest—there is no wrong answer.",html,{skip:"Nothing's stopping me"});
        bindMulti('blockers',99,null,null);
      }
      function renderNumbersGate(){
        var html='<div class="ihq-options two">'+optionHtml('Yes, show me rough numbers',state.wantNumbers===true,true)+optionHtml('No thanks, skip it',state.wantNumbers===false,true)+'</div><div class="ihq-cap-note">Totally optional. Ranges only—nothing exact, nothing shared.</div>';
        questionShell('Almost done','Want a rough sense of the numbers?',"If you add a few estimates, I will show a ballpark of the equity you may have to work with.",html,{nextLabel:'See my results'});
        var nextButton=document.getElementById('ihq-next');
        nextButton.disabled=state.wantNumbers===null;
        app.querySelectorAll('.ihq-opt').forEach(function(button){button.onclick=function(){app.querySelectorAll('.ihq-opt').forEach(function(item){item.classList.remove('selected')});button.classList.add('selected');state.wantNumbers=button.getAttribute('data-v').indexOf('Yes')===0;nextButton.disabled=false}});
      }
      function sliderBlock(label,key,min,max,step){return '<div class="ihq-slider-block"><div class="ihq-slider-top"><span class="ihq-slider-label">'+label+'</span><span class="ihq-slider-val" id="val-'+key+'">'+money(state[key])+'</span></div><input type="range" id="rng-'+key+'" min="'+min+'" max="'+max+'" step="'+step+'" value="'+state[key]+'"></div>'}
      function renderNumbers(){
        var html=sliderBlock('Estimated home value','homeValue',100000,2000000,25000)+sliderBlock('Mortgage balance remaining','mortgageBalance',0,1500000,25000)+sliderBlock('Comfortable monthly payment','comfortPayment',1000,10000,250)+'<div class="ihq-cap-note">Rough is fine—drag to the closest estimate.</div>';
        questionShell('The optional math','A few quick estimates','Ranges only. Slide to whatever feels close.',html,{nextLabel:'See my results'});
        ['homeValue','mortgageBalance','comfortPayment'].forEach(bindSlider);
      }
      function recommendations(){
        var items=[];
        state.blockers.forEach(function(blocker){if(blockerDetails[blocker])items.push(blockerDetails[blocker].tool)});
        if(state.wantNumbers===true) items.unshift(['Move-Up Mortgage Calculator','/tools/move-up-calculator/']);
        if(!items.length) items.push(['Real Estate Planning Tools','/tools/']);
        var seen={};
        return items.filter(function(item){if(seen[item[1]])return false;seen[item[1]]=true;return true}).slice(0,4);
      }
      function clarityLine(){
        if(state.wantNumbers===true){return 'With roughly '+money(Math.max(0,state.homeValue-state.mortgageBalance))+' in estimated gross equity, the move toward your ideal home may be more reachable than it feels day-to-day.'}
        if(state.blockers.length>1){return 'You named '+state.blockers.length+' things that make a move feel complicated. Looking at them one at a time can make the decision much clearer.'}
        return "Here is the honest read: you may be closer to clarity than it feels day-to-day.";
      }
      function renderResults(){
        app.innerHTML='';
        var priorities=state.missing.filter(function(item){return item!=='Nothing — just curious'});
        var tagsHtml=priorities.length?'<div class="ihq-tags">'+priorities.map(function(item){return '<span class="ihq-tag">'+escapeHtml(item)+'</span>'}).join('')+'</div>':'';
        var prioritiesBlock=tagsHtml?'<div class="ihq-reflect"><h3>The home you would actually choose</h3><p>You would want more of this:</p>'+tagsHtml+'</div>':'';
        var oneThingBlock=state.oneThing.trim()?'<div class="ihq-reflect"><h3>The one thing you would change</h3><p class="ihq-quote">&ldquo;'+escapeHtml(state.oneThing.trim())+'&rdquo;</p><p style="margin-top:8px">That is not really about real estate. It is about how you want your days to feel—and that is exactly the kind of thing worth planning around.</p></div>':'';
        var blockerBlocks=state.blockers.map(function(blocker){var detail=blockerDetails[blocker]||blockerDetails.Other;return '<div class="ihq-reflect"><h3>What is in the way: '+escapeHtml(blocker)+'</h3><p>'+escapeHtml(detail.reframe)+'</p></div>'}).join('');
        var equityBlock=state.wantNumbers===true?'<div class="ihq-equity"><div>Rough estimated gross equity</div><div class="ihq-equity-num">'+money(Math.max(0,state.homeValue-state.mortgageBalance))+'</div><small>Home value minus mortgage balance. Selling costs and your preferred cash reserve are not yet deducted.</small></div>':'';
        var toolsHtml=recommendations().map(function(item){var external=item[1].indexOf('http')===0;return '<a class="ihq-tool" href="'+item[1]+'"'+(external?' target="_blank" rel="noopener"':'')+' data-tool="'+escapeHtml(item[0])+'">'+escapeHtml(item[0])+'<span>&rarr;</span></a>'}).join('');
        var node=element('<div class="ihq-step ihq-result"><div class="ihq-card"><div class="ihq-result-eyebrow">Your clarity check</div><h2>You are not as far as you think</h2><p class="ihq-result-summary">'+escapeHtml(clarityLine())+'</p>'+prioritiesBlock+oneThingBlock+blockerBlocks+equityBlock+'<div class="ihq-reflect"><h3>A few good next steps</h3><p>Start with the question taking up the most space in your head. You do not need to use them all.</p><div class="ihq-tool-list">'+toolsHtml+'</div></div><div class="ihq-optin"><h3>Want the full picture?</h3><p>Talk through your results or get a no-pressure look at what your home could actually sell for today.</p><div class="ihq-contact-actions"><a class="ihq-btn ihq-btn-blue" href="https://jasonk.remax.com/contact.php" data-contact="Jason">Contact Jason</a><a class="ihq-btn ihq-btn-primary" href="https://ashlyn-sheppard.remax.com/contact.php" data-contact="Ashlyn">Contact Ashlyn</a></div><p class="ihq-privacy">Your answers stayed in this browser and were not submitted.</p></div><div class="ihq-result-actions"><button class="ihq-btn ihq-btn-ghost" id="ihq-copy">Copy results</button><button class="ihq-btn ihq-btn-ghost" id="ihq-restart">Start over</button><a class="ihq-btn ihq-btn-ghost" href="/tools/">See all tools</a></div></div></div>');
        app.appendChild(node);
        window.dataLayer=window.dataLayer||[];
        window.dataLayer.push({event:'ideal_home_quiz_complete',ownership:state.ownRent,priority_count:priorities.length,blocker_count:state.blockers.length,included_numbers:state.wantNumbers===true});
        app.querySelectorAll('[data-tool]').forEach(function(link){link.onclick=function(){window.dataLayer.push({event:'ideal_home_quiz_recommendation_click',recommendation:link.getAttribute('data-tool')})}});
        app.querySelectorAll('[data-contact]').forEach(function(link){link.onclick=function(){window.dataLayer.push({event:'ideal_home_quiz_contact_click',contact:link.getAttribute('data-contact')})}});
        document.getElementById('ihq-copy').onclick=copyResults;
        document.getElementById('ihq-restart').onclick=restart;
        window.scrollTo({top:0,behavior:'smooth'});
      }
      function bindSingle(key,after){app.querySelectorAll('.ihq-opt').forEach(function(button){button.onclick=function(){app.querySelectorAll('.ihq-opt').forEach(function(item){item.classList.remove('selected')});button.classList.add('selected');state[key]=button.getAttribute('data-v');if(after)after()}})}
      function bindMulti(key,max,capId,capText){app.querySelectorAll('.ihq-opt').forEach(function(button){button.onclick=function(){var value=button.getAttribute('data-v');var list=state[key];var index=list.indexOf(value);if(index>-1){list.splice(index,1);button.classList.remove('selected')}else{if(list.length>=max){if(capId){var cap=document.getElementById(capId);cap.textContent='That is '+max+'—tap one to swap';cap.classList.add('warn');setTimeout(function(){cap.textContent=capText;cap.classList.remove('warn')},1400)}return}list.push(value);button.classList.add('selected')}}})}
      function bindSlider(key){var range=document.getElementById('rng-'+key);var value=document.getElementById('val-'+key);range.oninput=function(){state[key]=parseInt(range.value,10);value.textContent=money(state[key])}}
      function next(){if(idx<steps().length-1){idx++;render();window.scrollTo({top:0,behavior:'smooth'})}}
      function previous(){if(idx>0){idx--;render();window.scrollTo({top:0,behavior:'smooth'})}}
      function restart(){state={ownRent:null,missing:[],oneThing:'',blockers:[],wantNumbers:null,homeValue:400000,mortgageBalance:200000,comfortPayment:2500};idx=0;render();window.scrollTo({top:0,behavior:'smooth'})}
      function copyResults(){
        var lines=['My Ideal Home Clarity Check','','Current situation: '+(state.ownRent||'Not answered'),'Home priorities: '+(state.missing.join(', ')||'None selected'),'One thing I would change: '+(state.oneThing.trim()||'Not answered'),'Planning blockers: '+(state.blockers.join(', ')||'None selected')];
        if(state.wantNumbers===true)lines.push('Estimated gross equity: '+money(Math.max(0,state.homeValue-state.mortgageBalance)));
        var text=lines.join('\n');
        if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(text).then(function(){var button=document.getElementById('ihq-copy');button.textContent='Results copied';setTimeout(function(){button.textContent='Copy results'},1800)}).catch(function(){window.prompt('Copy your results:',text)})}else{window.prompt('Copy your results:',text)}
      }
      render();
    })();
  </script>
</body>
</html>
