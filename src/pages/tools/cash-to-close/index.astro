---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import rates from '../../../data/mortgage-rates.json';
import '../../../styles/calculator.css';
---

<BaseLayout
  title="Down Payment & Cash-to-Close Planner"
  description="Compare down-payment options and estimate total cash needed for a home purchase, including closing costs, prepaids, deposits, credits, and reserves."
>
  <section class="calculator-hero">
    <div class="container">
      <span class="eyebrow">Cash-to-close planning</span>
      <h1>Your down payment is not the whole check.</h1>
      <p>Estimate the down payment, closing costs, prepaids, deposits, credits, and reserves—then compare how common down-payment options change the loan and payment.</p>
      <div class="rate-note">
        Default 30-year rate: {rates.thirtyYear.toFixed(2)}% · As of {rates.asOf} ·
        <a href={rates.sourceUrl} target="_blank" rel="noopener">Freddie Mac PMMS</a>
      </div>
    </div>
  </section>

  <section class="section calculator-shell">
    <div class="container cash-layout" id="cashTool">
      <div class="calculator-grid">
        <form class="calculator-card" id="cashInputs">
          <section class="input-section">
            <h2>Purchase and financing</h2>
            <p>Use your lender estimate when you have one. Until then, these are editable planning allowances.</p>
            <div class="field-grid">
              <div class="field">
                <label for="homePrice">Home price</label>
                <input id="homePrice" type="number" min="0" step="1000" value="450000" inputmode="decimal" />
              </div>
              <div class="field">
                <label for="downPercent">Down payment (%)</label>
                <input id="downPercent" type="number" min="0" max="100" step="0.5" value="5" inputmode="decimal" />
              </div>
              <div class="field">
                <label for="interestRate">Mortgage rate</label>
                <input id="interestRate" type="number" min="0" max="25" step="0.01" value={rates.thirtyYear} inputmode="decimal" />
              </div>
              <div class="field">
                <label for="loanTerm">Loan term</label>
                <select id="loanTerm">
                  <option value="30">30 years</option>
                  <option value="20">20 years</option>
                  <option value="15">15 years</option>
                </select>
              </div>
              <div class="field">
                <label for="taxRate">Property taxes (%/year)</label>
                <input id="taxRate" type="number" min="0" max="10" step="0.01" value="0.55" inputmode="decimal" />
              </div>
              <div class="field">
                <label for="insuranceAnnual">Homeowners insurance (annual)</label>
                <input id="insuranceAnnual" type="number" min="0" step="50" value="1800" inputmode="decimal" />
              </div>
              <div class="field full">
                <label for="pmiRate">Estimated mortgage insurance (% of loan/year)</label>
                <input id="pmiRate" type="number" min="0" max="5" step="0.05" value="0.50" inputmode="decimal" />
                <small>Applied below 20% down. Actual conventional, FHA, VA, or USDA costs follow program-specific rules.</small>
              </div>
            </div>
          </section>

          <section class="input-section">
            <h2>Closing-day assumptions</h2>
            <div class="field-grid">
              <div class="field">
                <label for="closingCostRate">Closing costs (% of price)</label>
                <input id="closingCostRate" type="number" min="0" max="20" step="0.25" value="3" inputmode="decimal" />
              </div>
              <div class="field">
                <label for="prepaids">Prepaids and initial escrow</label>
                <input id="prepaids" type="number" min="0" step="250" value="4500" inputmode="decimal" />
              </div>
              <div class="field">
                <label for="earnestMoney">Earnest money already paid</label>
                <input id="earnestMoney" type="number" min="0" step="250" value="5000" inputmode="decimal" />
              </div>
              <div class="field">
                <label for="otherDeposits">Other deposits already paid</label>
                <input id="otherDeposits" type="number" min="0" step="250" value="0" inputmode="decimal" />
              </div>
              <div class="field">
                <label for="credits">Seller/lender credits</label>
                <input id="credits" type="number" min="0" step="250" value="0" inputmode="decimal" />
                <small>Credits generally cannot replace the required down payment.</small>
              </div>
              <div class="field">
                <label for="reserve">Cash to keep after closing</label>
                <input id="reserve" type="number" min="0" step="500" value="15000" inputmode="decimal" />
              </div>
            </div>
          </section>

          <section class="input-section">
            <h2>Funds you expect to use</h2>
            <div class="field-grid">
              <div class="field">
                <label for="savings">Savings</label>
                <input id="savings" type="number" min="0" step="500" value="35000" inputmode="decimal" />
              </div>
              <div class="field">
                <label for="saleProceeds">Sale proceeds</label>
                <input id="saleProceeds" type="number" min="0" step="1000" value="0" inputmode="decimal" />
              </div>
              <div class="field">
                <label for="giftFunds">Gift or assistance funds</label>
                <input id="giftFunds" type="number" min="0" step="500" value="0" inputmode="decimal" />
              </div>
              <div class="field">
                <label for="otherFunds">Other available funds</label>
                <input id="otherFunds" type="number" min="0" step="500" value="0" inputmode="decimal" />
              </div>
            </div>
          </section>
        </form>

        <aside class="calculator-card results-panel" aria-live="polite">
          <span class="eyebrow">Closing snapshot</span>
          <h2>Estimated cash needed</h2>
          <div class="primary-result">
            <span>Bring to closing</span>
            <strong id="cashAtClosing">$0</strong>
          </div>
          <dl class="result-list">
            <div class="result-row"><dt>Down payment</dt><dd id="downPayment">$0</dd></div>
            <div class="result-row"><dt>Closing costs</dt><dd id="closingCosts">$0</dd></div>
            <div class="result-row"><dt>Prepaids and escrow</dt><dd id="prepaidsResult">$0</dd></div>
            <div class="result-row"><dt>Less credits</dt><dd id="creditsResult">$0</dd></div>
            <div class="result-row"><dt>Less deposits already paid</dt><dd id="depositsResult">$0</dd></div>
            <div class="result-row"><dt>Cash reserve after closing</dt><dd id="reserveResult">$0</dd></div>
            <div class="result-row"><dt>Total cash target</dt><dd id="totalCashTarget">$0</dd></div>
            <div class="result-row"><dt>Available funds</dt><dd id="availableFunds">$0</dd></div>
            <div class="result-row"><dt id="gapLabel">Estimated shortfall</dt><dd id="fundingGap">$0</dd></div>
          </dl>
          <div class="result-group">
            <h3>Estimated monthly payment</h3>
            <dl class="result-list">
              <div class="result-row"><dt>Loan amount</dt><dd id="loanAmount">$0</dd></div>
              <div class="result-row"><dt>Principal &amp; interest</dt><dd id="principalInterest">$0</dd></div>
              <div class="result-row"><dt>Taxes, insurance and MI</dt><dd id="otherMonthly">$0</dd></div>
              <div class="result-row"><dt>Total housing payment</dt><dd id="totalPayment">$0</dd></div>
            </dl>
          </div>
          <div class="result-actions">
            <button type="button" id="copyScenario">Copy scenario link</button>
            <a href="https://jasonk.remax.com/contact.php" data-contact="Jason">Plan the purchase</a>
          </div>
          <p class="calculation-disclosure">Planning estimate only—not a Loan Estimate, Closing Disclosure, loan approval, or guarantee. Program minimums, mortgage insurance, allowable credits, reserves, taxes, insurance, title charges, and prepaid items vary. Confirm all figures with your lender and closing professional.</p>
        </aside>
      </div>

      <section class="calculator-card comparison-card">
        <div class="comparison-heading">
          <div><span class="eyebrow">Quick comparison</span><h2>Common down-payment options</h2></div>
          <p>These scenarios use the same rate and cost assumptions above. They are comparisons, not statements of loan eligibility.</p>
        </div>
        <div class="scenario-grid" id="scenarioGrid"></div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .cash-layout { display: grid; gap: 1.25rem; }
  .results-panel .eyebrow { margin-bottom: .35rem; }
  .results-panel h2 { font-size: clamp(1.7rem, 3vw, 2.3rem); }
  .result-actions { grid-template-columns: 1fr; }
  .comparison-heading { display: grid; grid-template-columns: 1fr minmax(260px,.7fr); gap: 2rem; align-items: end; }
  .comparison-heading h2 { margin-top: .3rem; }
  .comparison-heading p { margin: 0; color: var(--muted); }
  .scenario-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: .75rem; margin-top: 1.2rem; }
  .scenario { padding: 1rem; border: 1px solid var(--line); border-top: 4px solid var(--blue-600); border-radius: .8rem; background: var(--mist); }
  .scenario.selected { border-top-color: var(--red-600); background: #fff5f6; }
  .scenario h3 { font-family: inherit; font-size: 1.05rem; }
  .scenario strong { display: block; margin: .75rem 0 .2rem; color: var(--navy-900); font-size: 1.35rem; }
  .scenario span, .scenario small { display: block; color: var(--muted); }
  @media(max-width:900px){ .scenario-grid { grid-template-columns: 1fr 1fr; } }
  @media(max-width:620px){ .comparison-heading, .scenario-grid { grid-template-columns: 1fr; } }
</style>

<script is:inline>
  const toolId = 'cash-to-close';
  const root = document.getElementById('cashTool');
  const form = document.getElementById('cashInputs');
  const controls = Array.from(form.querySelectorAll('input, select'));
  const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  let started = false;
  const num = (id, min = 0, max = Infinity) => {
    const value = Number(document.getElementById(id)?.value || 0);
    return Math.min(max, Math.max(min, Number.isFinite(value) ? value : 0));
  };
  const setMoney = (id, value) => { document.getElementById(id).textContent = money.format(Number.isFinite(value) ? value : 0); };
  const track = (event, data = {}) => { window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event, tool_id: toolId, ...data }); };

  function mortgagePayment(principal, annualRate, years) {
    if (principal <= 0 || years <= 0) return 0;
    const months = years * 12;
    const rate = annualRate / 100 / 12;
    return rate === 0 ? principal / months : principal * rate / (1 - Math.pow(1 + rate, -months));
  }

  function scenario(downPercent) {
    const price = num('homePrice');
    const down = price * Math.min(100, Math.max(0, downPercent)) / 100;
    const loan = Math.max(0, price - down);
    const pi = mortgagePayment(loan, num('interestRate', 0, 25), num('loanTerm', 1, 50));
    const taxes = price * num('taxRate', 0, 10) / 100 / 12;
    const insurance = num('insuranceAnnual') / 12;
    const pmi = downPercent < 20 ? loan * num('pmiRate', 0, 5) / 100 / 12 : 0;
    const payment = pi + taxes + insurance + pmi;
    const closing = price * num('closingCostRate', 0, 20) / 100;
    const creditsApplied = Math.min(num('credits'), closing + num('prepaids'));
    const deposits = num('earnestMoney') + num('otherDeposits');
    const cashAtClosing = Math.max(0, down + closing + num('prepaids') - creditsApplied - deposits);
    return { downPercent, price, down, loan, pi, taxes, insurance, pmi, payment, closing, creditsApplied, deposits, cashAtClosing };
  }

  function calculate(shouldTrack = false) {
    const result = scenario(num('downPercent', 0, 100));
    const reserve = num('reserve');
    const totalTarget = result.cashAtClosing + reserve;
    const available = num('savings') + num('saleProceeds') + num('giftFunds') + num('otherFunds');
    const gap = available - totalTarget;
    setMoney('cashAtClosing', result.cashAtClosing);
    setMoney('downPayment', result.down);
    setMoney('closingCosts', result.closing);
    setMoney('prepaidsResult', num('prepaids'));
    setMoney('creditsResult', -result.creditsApplied);
    setMoney('depositsResult', -result.deposits);
    setMoney('reserveResult', reserve);
    setMoney('totalCashTarget', totalTarget);
    setMoney('availableFunds', available);
    document.getElementById('gapLabel').textContent = gap >= 0 ? 'Funds above target' : 'Estimated shortfall';
    setMoney('fundingGap', Math.abs(gap));
    document.getElementById('fundingGap').classList.toggle('negative', gap < 0);
    setMoney('loanAmount', result.loan);
    setMoney('principalInterest', result.pi);
    setMoney('otherMonthly', result.taxes + result.insurance + result.pmi);
    setMoney('totalPayment', result.payment);

    const selected = result.downPercent;
    const options = Array.from(new Set([3, 5, 10, 20, selected])).sort((a,b) => a-b);
    document.getElementById('scenarioGrid').innerHTML = options.map((percent) => {
      const item = scenario(percent);
      return `<article class="scenario ${Math.abs(percent-selected)<.001?'selected':''}">
        <h3>${percent.toLocaleString('en-US',{maximumFractionDigits:1})}% down</h3>
        <span>${money.format(item.down)} down payment</span>
        <strong>${money.format(item.cashAtClosing)} at closing</strong>
        <small>${money.format(item.payment)}/mo estimated housing · ${money.format(item.loan)} loan</small>
      </article>`;
    }).join('');
    if (shouldTrack) track('tool_calculate');
  }

  function query() {
    const params = new URLSearchParams();
    controls.forEach((control) => params.set(control.id, control.value));
    return params;
  }

  const initial = new URLSearchParams(window.location.search);
  controls.forEach((control) => { if (initial.has(control.id)) control.value = initial.get(control.id); });
  controls.forEach((control) => control.addEventListener('input', () => {
    if (!started) { started = true; track('tool_start'); }
    calculate(false);
  }));
  form.addEventListener('change', () => calculate(true));
  document.getElementById('copyScenario').addEventListener('click', async () => {
    const url = `${window.location.origin}${window.location.pathname}?${query()}`;
    try { await navigator.clipboard.writeText(url); } catch { window.prompt('Copy this link:', url); }
    document.getElementById('copyScenario').textContent = 'Link copied';
    setTimeout(() => { document.getElementById('copyScenario').textContent = 'Copy scenario link'; }, 1800);
    track('tool_share', { tool_action: 'copy_scenario' });
  });
  root.querySelector('[data-contact]').addEventListener('click', () => track('tool_contact_click', { contact_destination: 'Jason' }));
  track('tool_view');
  calculate(false);
</script>
