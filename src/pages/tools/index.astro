---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';
---

<BaseLayout title="Home Buying & Selling Calculators" description="Free calculators for mortgage terms, home equity, down payments, affordability, commute costs, and planning a move in Middle Tennessee.">
  <section class="tools-hero">
    <div class="container">
      <span class="eyebrow">Jason Kaczmarski · Middle Tennessee real estate</span>
      <div class="hero-row">
        <h1>Planning tools</h1>
        <p>Practical calculators and decision guides from The Jason Kaczmarski Team—for buyers and homeowners who want to understand the numbers before making a move.</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="tool-grid">{tools.map((tool) => <ToolCard tool={tool} />)}</div>
      <aside>
        <strong>A note about the numbers</strong>
        <p>These tools provide planning estimates—not loan quotes, appraisals, or guarantees. Each migrated tool will show its assumptions, source dates, and calculation methodology.</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .tools-hero { padding: clamp(2.25rem, 5vw, 3.75rem) 0; background: var(--navy-900); color: white; }
  .tools-hero .eyebrow { color: rgba(255,255,255,.62); }
  .hero-row { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(2rem, 7vw, 7rem); align-items: end; }
  .tools-hero h1 { margin: 0; font-size: clamp(2.25rem, 4vw, 3.65rem); }
  .tools-hero p { max-width: 680px; margin: 0; color: rgba(255,255,255,.72); font-size: 1rem; }
  .tool-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  aside { display: grid; grid-template-columns: .35fr 1fr; gap: 2rem; margin-top: 3rem; padding: 1.4rem 0; border-top: 1px solid var(--line); color: var(--muted); }
  aside strong { color: var(--navy-900); }
  @media(max-width: 720px) { .hero-row, .tool-grid, aside { grid-template-columns: 1fr; } .hero-row { gap: 1rem; } }
</style>
