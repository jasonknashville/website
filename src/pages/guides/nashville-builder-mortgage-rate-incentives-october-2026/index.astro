const description = 'Mortgage rates have hit a nearly three-year high, but some Nashville-area builders offer rate incentives on select new homes. Compare the terms and request a list.';
const publishedDate = '2026-10-14';
const schema = {'@context':'https://schema.org','@type':'Article',headline:title,description,datePublished:publishedDate,dateModified:publishedDate,mainEntityOfPage:'https://jasonknashville.com/guides/nashville-builder-mortgage-rate-incentives-october-2026/',author:{'@type':'Person',name:'Jason Kaczmarski'},publisher:{'@type':'RealEstateAgent',name:'RE/MAX 1st Choice'}};
