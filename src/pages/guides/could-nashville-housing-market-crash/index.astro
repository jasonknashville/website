const title = 'Could Nashville’s Housing Standoff Turn Into a Crash?';
const description = 'Florida and Las Vegas share parts of Nashville’s post-boom housing setup. Here are the warning signs that would turn a slow market into a genuine crash risk.';
const publishedDate = '2026-08-25';
