---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools';
const heroImage = 'https://kvcore-library.s3.amazonaws.com/remax1stchoice8207/images/36e9d94a41744196b10ed128cf51dce2.jpeg';
---

<BaseLayout title="Nashville & Middle Tennessee Real Estate Tools" description="Practical calculators and local guidance for buying, selling, and planning a move across Nashville and Middle Tennessee.">
  <section class="hero" style={`--hero-image: url("${heroImage}")`}>
    <div class="hero-photo" aria-hidden="true"></div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-content">
      <p class="hero-kicker">Clear answers for your next move</p>
      <h1>Make the next real estate decision clearer.</h1>
      <p class="hero-copy">Use practical calculators and candid local guidance for buying, selling, or moving up in Nashville and Middle Tennessee.</p>
      <div class="hero-actions">
        <a class="button" href="/tools/">Explore the Tool Hub</a>
      </div>
      <p class="hero-proof">Jason Kaczmarski <span aria-hidden="true">·</span> Licensed since 2007 <span aria-hidden="true">·</span> RE/MAX Hall of Fame</p>
    </div>
  </section>

  <section class="section tools-preview">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Start with your question</span>
        <h2>Choose the decision you want to make clearer.</h2>
        <p>Change the assumptions privately and reach out only if a conversation would help.</p>
      </div>
      <div class="tool-grid">
        {tools.slice(0, 3).map((tool) => <ToolCard tool={tool} />)}
      </div>
      <a class="all-tools" href="/tools/">View the full Tool Hub <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container contact-card">
      <div class="contact-copy">
        <span class="eyebrow">Prefer a conversation?</span>
        <h2>Talk through the next step with us.</h2>
        <p>No pressure and no need to have every number figured out first.</p>
      </div>
      <div class="contact-actions">
        <a href="https://jasonk.remax.com/contact.php">Contact Jason</a>
        <a href="https://ashlyn-sheppard.remax.com/contact.php">Contact Ashlyn</a>
        <a href="https://the-jason-kaczmarski-team-springfield-tn.remax.com/">Search for homes</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; min-height: min(680px, calc(100vh - 74px)); display: grid; align-items: end; overflow: hidden; background: var(--navy-950); color: white; }
  .hero-photo, .hero-shade { position: absolute; inset: 0; }
  .hero-photo { background-image: var(--hero-image); background-size: cover; background-position: center; transform: scale(1.01); }
  .hero-shade { background: linear-gradient(90deg, rgba(7,24,45,.96) 0%, rgba(7,24,45,.75) 48%, rgba(7,24,45,.25) 100%), linear-gradient(0deg, rgba(7,24,45,.88) 0%, transparent 60%); }
  .hero-content { position: relative; z-index: 2; padding-bottom: clamp(3.5rem, 7vw, 5.5rem); }
  .hero-content h1 { max-width: 780px; margin-bottom: 1.2rem; }
  .hero-kicker { margin-bottom: 1rem; color: #f29aa6; font-size: .78rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .hero-copy { max-width: 700px; margin-bottom: 2rem; color: rgba(255,255,255,.78); font-size: clamp(1.05rem, 2vw, 1.28rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; }
  .hero-proof { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1.5rem; color: rgba(255,255,255,.62); font-size: .78rem; font-weight: 600; letter-spacing: .03em; }
  .tools-preview { background: var(--mist); }
  .tool-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .all-tools { display: inline-flex; gap: .5rem; margin-top: 2rem; color: var(--navy-900); font-weight: 700; text-decoration: none; }
  .contact-section { background: var(--paper); }
  .contact-card { display: grid; grid-template-columns: minmax(0, .85fr) minmax(480px, 1.15fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; padding: clamp(2rem, 5vw, 4rem); border-radius: var(--radius-lg); background: var(--navy-900); color: white; }
  .contact-copy h2 { margin-bottom: .65rem; }
  .contact-copy p { margin: 0; color: rgba(255,255,255,.68); }
  .contact-actions { display: grid; gap: .75rem; }
  .contact-actions a { display: flex; align-items: center; justify-content: space-between; min-height: 3.35rem; padding: .8rem 1.15rem; border: 1px solid rgba(255,255,255,.2); border-radius: .85rem; color: white; font-weight: 700; text-decoration: none; transition: background .2s ease, border-color .2s ease, transform .2s ease; }
  .contact-actions a::after { content: '→'; color: #f2cfd4; }
  .contact-actions a:hover { transform: translateY(-2px); border-color: rgba(255,255,255,.5); background: rgba(255,255,255,.08); }
  @media(max-width: 980px) {
    .tool-grid, .contact-card { grid-template-columns: 1fr; }
  }
  @media(max-width: 760px) {
    .hero { min-height: 620px; }
    .hero-shade { background: linear-gradient(0deg, rgba(7,24,45,.98) 0%, rgba(7,24,45,.76) 70%, rgba(7,24,45,.35) 100%); }
    .hero-proof { display: block; line-height: 1.65; }
    .hero-proof span { padding-inline: .25rem; }
  }
</style>
